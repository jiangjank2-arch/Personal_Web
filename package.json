{
  "name": "personal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/check-content.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "admin:dev": "astro build && wrangler pages dev dist --port 8788",
    "test:e2e": "playwright test",
    "github:import": "node scripts/import-github.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "wrangler": "^4.155.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
