---
import { Image } from 'astro:assets';
import { profile } from '@/data/profile';
import { skills } from '@/data/skills';
const sorted = [...skills].sort((a, b) => a.order - b.order);
---
<section id="about" class="section container">
  <div class="about-hero reveal">
    <div class="about-avatar">{profile.avatar ? <Image src={profile.avatar} alt={`${profile.name} 的头像`} width={208} height={208} /> : <span aria-hidden="true">✦</span>}</div>
    <p class="eyebrow">01 / ABOUT · 关于我</p>
    <h2 class="about-title">About Me<span class="accent-text">.</span></h2>
    <div class="about-bio">{profile.bio.map((paragraph) => <p>{paragraph}</p>)}</div>
    <a class="text-link" href="#contact">聊聊你的想法 ↗</a>
  </div>
  <ul class="skill-grid">{sorted.map((skill, i) => <li class="skill-card reveal" style={`--reveal-delay: ${i + 1}`}><h3>{skill.name}</h3><p>{skill.category}</p></li>)}</ul>
</section>
