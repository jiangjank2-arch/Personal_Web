---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { POSTS_PER_PAGE } from '@/lib/content';
interface Props { posts: CollectionEntry<'blog'>[]; currentPage?: number }
const { posts, currentPage = 1 } = Astro.props;
const pages = Math.ceil(posts.length / POSTS_PER_PAGE);
const visible = posts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
---
<div class="post-list">{visible.map((post) => <PostCard post={post} />)}</div>
{visible.length === 0 && <p class="empty-state">还没有公开文章，第一篇记录正在路上。</p>}
{pages > 1 && <nav class="pagination" aria-label="博客分页">{Array.from({ length: pages }, (_, i) => i + 1).map((number) => <a class="button-secondary" href={number === 1 ? '/blog/' : `/blog/page/${number}/`} aria-current={number === currentPage ? 'page' : undefined}>第 {number} 页</a>)}</nav>}

