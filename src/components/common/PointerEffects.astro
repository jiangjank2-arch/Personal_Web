---
const particles = Array.from({ length: 14 });
---
<div class="pointer-effects" data-pointer-effects aria-hidden="true" hidden>
  <div class="pointer-glow" data-pointer-glow></div>
  <div class="pointer-orbit" data-pointer-orbit><span class="pointer-ring"></span></div>
  <div class="pointer-position" data-pointer-position><span class="pointer-star"></span></div>
  <div class="pointer-ripple" data-pointer-ripple></div>
  {particles.map(() => <span class="pointer-particle"></span>)}
</div>
<script>
  import '@/scripts/pointer-effects';
</script>

