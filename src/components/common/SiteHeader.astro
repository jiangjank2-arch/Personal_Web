---
import { site } from '@/data/site';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Personal Web 首页"><span class="brand-star" aria-hidden="true">✦</span> Personal<span class="brand-light">Web</span><span class="brand-dot">.</span></a>
    <button class="menu-toggle button-secondary" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>菜单 <span aria-hidden="true">☰</span></button>
    <nav id="site-navigation" aria-label="主导航">
      {site.navigation.map(({ label, href }) => (
        <a href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  import '@/scripts/mobile-menu';
</script>

