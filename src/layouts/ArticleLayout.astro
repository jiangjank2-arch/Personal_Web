---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; backHref: string; backLabel: string }
const { title, description, backHref, backLabel } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="article-shell container">
    <a class="back-link" href={backHref}>← {backLabel}</a>
    <header class="article-header">
      <slot name="meta" />
      <h1>{title}</h1>
      <p class="article-summary">{description}</p>
      <slot name="links" />
    </header>
    <div class="prose"><slot /></div>
    <a class="back-link article-back" href={backHref}>← {backLabel}</a>
  </article>
</BaseLayout>

