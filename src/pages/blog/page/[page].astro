---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/blog/PostList.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '@/lib/content';
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return Array.from({ length: Math.max(0, Math.ceil(posts.length / POSTS_PER_PAGE) - 1) }, (_, i) => ({
    params: { page: String(i + 2) }, props: { posts, currentPage: i + 2 },
  }));
}) satisfies GetStaticPaths;
const { posts, currentPage } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---
<BaseLayout title={`博客 · 第 ${currentPage} 页`}>
  <div class="container listing-page">
    <header class="page-heading"><p class="eyebrow">JOURNAL / 第 {currentPage} 页</p><h1>更多学习记录<span class="accent-text">.</span></h1></header>
    <PostList posts={posts} currentPage={currentPage} />
  </div>
</BaseLayout>

